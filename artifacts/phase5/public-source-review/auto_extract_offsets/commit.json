      "patch": "@@ -4,7 +4,6 @@ on:\n   workflow_dispatch:\n   push:\n     paths:\n-      - boot.img\n       - auto_extract_offsets.py\n \n jobs:\n@@ -16,28 +15,33 @@ jobs:\n       uses: actions/checkout@v4\n \n     - name: 安装系统依赖\n-      run: |\n-        sudo apt-get update\n-        sudo apt-get install -y python3 python3-pip wget unzip\n+      run: sudo apt-get update && sudo apt-get install -y python3 python3-pip wget unzip\n \n     - name: 安装 Python 依赖\n       run: pip3 install vmlinux-to-elf\n \n-    - name: 检查 boot.img 是否存在\n+    - name: 从远程下载 boot.img\n       run: |\n-        if [ ! -f boot.img ]; then echo \"错误：根目录下未找到 boot.img。\"; exit 1; fi\n-        echo \"boot.img 已找到，大小：$(du -h boot.img | cut -f1)\"\n-\n-    - name: 创建目标文件夹并运行偏移提取脚本\n+        wget -q --show-progress https://r2.262832.xyz/raw/boot/boot.img -O boot.img\n+        if [ ! -f boot.img ]; then\n+          echo \"错误：boot.img 下载失败\"\n+          exit 1\n+        fi\n+        echo \"boot.img 下载成功，大小：$(du -h boot.img | cut -f1)\"\n+\n+    - name: 运行偏移提取脚本并移动 target.h 到根目录\n       run: |\n-        mkdir -p target\n         python3 auto_extract_offsets.py boot.img -o . --device blazer --target-name target --keep-intermediate\n-\n-    - name: 验证并上传 target.h\n-      run: |\n-        if [ ! -f target/target.h ]; then echo \"错误：target.h 未生成\"; exit 1; fi\n+        if [ -f target/target.h ]; then\n+          mv target/target.h ./target.h\n+        else\n+          echo \"错误：target.h 未生成\"\n+          exit 1\n+        fi\n+\n+    - name: 上传 target.h 作为 Artifact\n       uses: actions/upload-artifact@v4\n       with:\n         name: target-h\n-        path: target/target.h\n+        path: target.h\n         if-no-files-found: error\n\\ No newline at end of file"
