      "patch": "@@ -0,0 +1,6 @@\n+API ?= 35\n+NDK_ROOT ?= $(HOME)/android-ndk-cache/android-ndk-r29\n+CC := $(NDK_ROOT)/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android$(API)-clang\n+\n+exploit: exploit.c\n+    $(CC) -std=gnu17 -O2 -g -static -pthread -Wall -Wextra -Werror $< -o $@\n\\ No newline at end of file"
    },
    {
      "sha": "f16453774f66f95f796ec170af77f5cf51179c55",
      "filename": "security-research/Ndays/Android-CVE-2026-64560/README.MD",
      "status": "added",
