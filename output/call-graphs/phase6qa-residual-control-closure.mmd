flowchart LR
    TX6["IAmazonPackageManager tx6\nregisterProxyReceiver"] --> G6["FLAG_SYSTEM creator\n+ queryBroadcastReceivers"]
    G6 --> MAP["ProxyReceiver\nmOnTheFlyRegisteredIntents"]
    MAP --> SEND["PendingIntent.send()\nforwarding sink"]
    SEND --> NOHOME["No PMS / HOME / Fire\nwriter recovered"]

    TX7["IAmazonPackageManager tx7\nderegisterProxyReceiver"] --> G7["creatorUid ==\nBinder.getCallingUid()"]
    G7 --> UNREG["remove owner entry\nthen unregisterReceiver"]
    UNREG --> NOHOME

    VREC["Vending\nLauncherConfigurationReceiver"] --> VT["verificationToken\ncurrent-launcher + setup/HOME checks"]
    VT --> RESTORE["Play restore / hotseat /\nworkspace bookkeeping"]
    RESTORE --> NOHOME

    DSE["Vending DseService"] --> GDSE["DSE permission + DeviceSetup\n+ calling UID authorization"]
    GDSE --> DSESINK["browser/search/secure settings/\nSetup Wizard/install bookkeeping"]
    DSESINK --> NOHOME

    SETTINGS["Settings / PMS HOME surface"] --> KEYS["default_home\nconfig_show_default_home=true"]
    KEYS --> PICKER["dormant/internal\nDefaultHomePicker"]
    PICKER --> PREF["replacePreferredActivity()\nper-user preferred state"]
    PREF --> FIRE["Fire effective priority 50\nremains resolver winner"]

