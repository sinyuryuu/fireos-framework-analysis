  classDef boundary fill:#fff1b8,stroke:#d48806,color:#000;
  classDef blocked fill:#ffd6e7,stroke:#c41d7f,color:#000;
  class C,D,E,F,G,H,I,J,L,M,N,O,U,V,AA,AB,AC confirmed;
  class P,Q,W,X,Y,Z boundary;
  class R,S,T blocked;
