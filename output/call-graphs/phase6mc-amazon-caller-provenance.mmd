    ChildWriter --> ChildScope["Child user only:\nTahoe enabled; Fire/Launcher3 state 2"]

    Tx4["IAmazonUserManager tx4"] --> Setup["setup settings only\nidentity cleared"]
    Prewarm["AmazonActivityManager preWarmApplicationForUser"] --> Process["startProcessLocked / prewarm"]
    OTA["AmazonPackageManagerService.onBootPhase(550)\nisUpgrade"] --> Broadcast["protected BOOT_AFTER_SYSTEM_OTA"]
    Broadcast --> OOBE["BootAfterSystemOTAReceiver\nOOBE/setup state"]

    ChildScope -. "no User-0 HOME sink observed" .-> Fire["Fire Launcher HOME"]
