flowchart LR
    A["ordinary APK / ADB shell"] --> B["exported API or service discovery"]
    B --> C["permission + SELinux + caller gate"]
    C --> D["Binder identity + user scope"]
    D --> E["concrete sink"]

    H["H2ClientService"] --> H1["signature|amazon bind"]
    H1 --> H2["child/profile workflow"]
