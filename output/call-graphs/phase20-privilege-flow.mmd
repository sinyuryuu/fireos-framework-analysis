    O["OTA Java verifier"] --> O1["RecoverySystem / UpdateSystem"]
    O1 --> O2["update_verifier / recovery capability"]
    O2 -.-> P["partition/slot sink; caller unresolved"]

    M["meta_tst"] --> M1["gsensor / USB sysfs policy edge"]
    R["rpmb_svc"] --> R1["TEE / RPMB policy edge"]
    M1 -.-> N["hardware diagnostic sink"]
    R1 -.-> N

    Z["Phase 20"] --> Q["No ordinary-caller chain to Fire/HOME/UID0 sink"]
    Q -.-> E

