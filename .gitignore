# GitHub cannot accept the raw OTA/system images and several generated
# disassembly files in this workspace. The public repository keeps reports,
# scripts, manifests, small evidence, and source references; local-only inputs
# are identified in PUBLIC_REPOSITORY_SCOPE.md.

firmware/original/
firmware/extracted/
firmware/partitions/

decompiled/baksmali/
decompiled/apktool/
decompiled/jadx/

# Device-pulled binary artifacts remain local; their hashes/manifests and XML
# registration files remain publishable.
artifacts/**/*.apk
artifacts/**/*.jar
artifacts/**/*.odex
artifacts/**/*.vdex
artifacts/**/*.dex
artifacts/**/*.so

# Phase 5J exact Bluetooth pulled binaries and full VDEX disassembly remain
# local-only; the public copy keeps hashes, manifests, configs, and focused
# derived slices.
adb/phase5/PHASE5J-BLUETOOTH-ARTIFACTS-*/files/*.apk
adb/phase5/PHASE5J-BLUETOOTH-ARTIFACTS-*/files/*.odex
adb/phase5/PHASE5J-BLUETOOTH-ARTIFACTS-*/files/*.vdex
adb/phase5/PHASE5J-BLUETOOTH-ARTIFACTS-*/files/*.so
adb/phase5/PHASE5J-BLUETOOTH-ARTIFACTS-*/files/*.ko
artifacts/phase5/phase5j-bluetooth-vdex-extract/

# Large generated indexes are reproducible and are not source evidence.
output/tables/*.tsv
output/tables/*.absolute.tsv
output/tables/*method-signatures*.csv
output/tables/*class-index*.csv

# Generated reports that exceed ordinary GitHub review/hosting limits.
diff/reports/**/methods_fireos_only.txt
diff/reports/**/methods_aosp_only.txt
diff/reports/**/launcher-reference-contexts*.tsv
diff/reports/**/home-reference-index*.tsv

# Local tool caches and OS/editor files.
.git
tools/third-party/vdexExtractor/
.DS_Store
*.swp
__pycache__/
*.pyc

# Phase 3A local build staging and signing material.
tools/test-launcher/dist/*/work/
tools/test-launcher-phase4/dist/
tools/phase4-accessibility/dist/
*.keystore
*.jks

# The approved direct MTK root-test payload remains local-only. Publish its
# hash, command records, and stdout/stderr, not the executable itself.
adb/phase5/MTK-SU-CMDQ-T03/host/mtk-su64
adb/phase5/MTK-SU-CMDQ-T03/sha256sums.txt

# Phase 5K host-only public-source working copies and large bounded samples.
# Reports, evidence rows, and the reproducible collector remain publishable;
# third-party exploit source and multi-gigabyte archive slices stay local.
# Keep only small provenance metadata for public-source review. The checked-out
# third-party source and exploit files remain local-only.
artifacts/phase5/public-source-review/CyberMeowfia/
artifacts/phase5/public-source-review/CyberMeowfia/*
artifacts/phase5/public-source-review/auto_extract_offsets/auto_extract_offsets.py
artifacts/phase5/public-source-review/auto_extract_offsets/*.py
artifacts/phase5/public-source-review/auto_extract_offsets/Makefile
artifacts/phase5/public-source-review/auto_extract_offsets/README*
artifacts/phase5/public-source-review/auto_extract_offsets/extract_offsets.yml
artifacts/phase5/public-source-review/linux-rtmutex/*.c
artifacts/phase5/exact-source-sampling-*/
artifacts/phase5/exact-source-cve-paths-*/

# Full PS7330 source extraction is retained locally for provenance checks; the
# public repository keeps the extractor, metadata, hashes, and reports.
artifacts/phase5/ps7330-full-source-members-*/extracted/

# Phase 5M pulled system/vendor shared objects remain local-only. The public
# repository keeps their remote hashes, metadata, and host-derived disassembly.
adb/phase5/PHASE5M-MTK-LIBS-*/files/*.so

# Preserve small provenance files from the ignored CyberMeowfia checkout.
!artifacts/phase5/public-source-review/CyberMeowfia/
!artifacts/phase5/public-source-review/CyberMeowfia/commit.json
!artifacts/phase5/public-source-review/CyberMeowfia/tree.json
!artifacts/phase5/public-source-review/CyberMeowfia/tree-selected.tsv
!artifacts/phase5/public-source-review/CyberMeowfia/sha256sums.txt
